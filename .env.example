# Zkopírujte jako .env a vyplňte.

# Claude (vyhledávání firem, posouzení, vyhodnocení hovorů)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Vapi – privátní API klíč, ID asistenta (AI obchodník) a ID telefonního čísla, ze kterého se volá
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# Veřejná adresa serveru (https). Pak systém Vapi u každého hovoru řekne, kam poslat výsledek.
# Bez ní funguje taky – výsledky si každé 3 minuty stáhne z Vapi samo.
PUBLIC_BASE_URL=
WEBHOOK_SECRET=nahodny-dlouhy-retezec
# false = neměnit server URL asistenta (když ji asistent používá pro vlastní nástroje)
VAPI_OVERRIDE_SERVER_URL=true

# Volitelné: Google Places jako další zdroj firem
GOOGLE_MAPS_API_KEY=

# E-maily (bez SMTP_HOST se e-maily jen ukládají do data/outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI obchodník <obchodnik@vasefirma.cz>
# komu chodí reporty a horké leady (Freeheating), čárkou oddělené
REPORT_TO=
# kopie pro vás
REPORT_CC=
# kam chodí výsledky zkušebních hovorů (výchozí REPORT_CC)
TEST_EMAIL=

# Přehled na https://.../ (bez hesla je vypnutý)
ADMIN_USER=admin
ADMIN_PASSWORD=

# DATA_DIR=data
# CONFIG_PATH=config.yaml
# SCHEDULER_ENABLED=true
